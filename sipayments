<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ABDI MULTI PAYMENTS</title>

<style>
:root{
    --primary:#0d1b2a;
    --secondary:#1b263b;
    --accent:#00b4d8;
    --light:#f8f9fa;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:var(--primary);
    color:var(--light);
}

header{
    background:var(--secondary);
    padding:25px 20px;
    text-align:center;
    border-bottom:3px solid var(--accent);
}

header h1{
    font-size:28px;
    letter-spacing:1px;
}

header p{
    margin-top:8px;
    font-size:14px;
    color:#ccc;
}

.container{
    max-width:1100px;
    margin:auto;
    padding:40px 20px;
}

.section-title{
    font-size:20px;
    margin-bottom:20px;
    border-left:4px solid var(--accent);
    padding-left:10px;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:15px;
}

.card{
    background:var(--secondary);
    padding:15px;
    border-radius:6px;
    transition:0.3s;
    cursor:pointer;
    border:1px solid transparent;
}

.card:hover{
    border:1px solid var(--accent);
    transform:translateY(-3px);
}

.footer{
    background:var(--secondary);
    text-align:center;
    padding:20px;
    font-size:13px;
    margin-top:40px;
    border-top:2px solid var(--accent);
}

.btn-wa{
    display:inline-block;
    margin-top:20px;
    padding:12px 25px;
    background:var(--accent);
    color:#000;
    font-weight:bold;
    text-decoration:none;
    border-radius:5px;
}

.btn-wa:hover{
    opacity:0.8;
}
</style>
</head>

<body>

<header>
    <h1>ABDI MULTI PAYMENTS</h1>
    <p>KODE AGEN : JKT-800225</p>
</header>

<div class="container">

    <div class="section-title">Reservasi Tiket</div>
    <div class="grid">
        <div class="card">Flight</div>
        <div class="card">Flight Class</div>
        <div class="card">Kereta Api</div>
        <div class="card">Hotel</div>
        <div class="card">Bus</div>
        <div class="card">Travel</div>
    </div>

    <br><br>

    <div class="section-title">Pembayaran Tagihan</div>
    <div class="grid">
        <div class="card">Pulsa All Operator</div>
        <div class="card">Paket Data Internet</div>
        <div class="card">Token PLN</div>
        <div class="card">PLN Pascabayar</div>
        <div class="card">PDAM</div>
        <div class="card">BPJS</div>
        <div class="card">Telkom</div>
        <div class="card">TV Kabel</div>
        <div class="card">Multifinance</div>
        <div class="card">Bayar Pajak</div>
        <div class="card">Bayar Paspor</div>
        <div class="card">Bayar SPT Bulanan</div>
    </div>

    <br><br>

    <div style="text-align:center;">
        <a class="btn-wa" href="https://wa.me/6282296066117" target="_blank">
            HUBUNGI SEKARANG
        </a>
    </div>

</div>

<div class="footer">
       ABDI MULTI PAYMENT<br>
